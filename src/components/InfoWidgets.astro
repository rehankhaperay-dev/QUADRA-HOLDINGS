---
import { iconSrcSet, withBase } from '../lib/paths';
const widgets = [
  { label: 'Location', value: 'Saudi Arabia', icon: 'location' },
  { label: 'Availability', value: 'Online worldwide', icon: 'globe' },
  { label: 'Focus', value: 'Small businesses', icon: 'storefront' },
  { label: 'Contact', value: 'Send an email', icon: 'mail', href: 'mailto:rehan.khaperay@gmail.com' },
];
---
<!-- The original template's four compact info widgets, adapted with real details. -->
<div class="info-grid" id="overview" aria-label="Quadra at a glance">
  {widgets.map((widget) => (
    <div class="info-widget reveal">
      <span class={`info-icon info-icon--${widget.icon}`} aria-hidden="true">
        <img src={withBase(`images/ai/${widget.icon}.webp`)} srcset={iconSrcSet(widget.icon)} sizes="(max-width: 600px) 38px, 48px" width="192" height="192" loading="lazy" decoding="async" alt="" />
      </span>
      <span class="info-text"><span>{widget.label}</span>{widget.href ? <a href={widget.href}>{widget.value} ↗</a> : <strong>{widget.value}</strong>}</span>
    </div>
  ))}
</div>
