---
import ProjectCard from './ProjectCard';
import { projects } from '../data/project';
---
<!-- The original featured-projects widget now follows services in the visitor journey. -->
<section class="widget-panel projects-widget reveal" id="work" aria-labelledby="work-heading">
  <div class="widget-heading"><div><span class="widget-kicker">02 / A SPACE FOR WHAT'S NEXT</span><h2 id="work-heading">Portfolio</h2></div><div class="carousel-buttons" data-js-control hidden><button class="round-control" type="button" data-project-prev aria-label="Previous project"><span aria-hidden="true">←</span></button><button class="round-control" type="button" data-project-next aria-label="Next project"><span aria-hidden="true">→</span></button></div></div>
  <p class="widget-lead project-lead">These are illustrative placeholders for future practice projects—not completed client work.</p>
  <div class="project-track" data-project-track tabindex="0" role="region" aria-label="Portfolio placeholders. Scroll or use the controls to explore.">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
  <p class="project-hint">FUTURE PRACTICE PROJECTS / USE THE ARROWS OR SWIPE <span aria-hidden="true">↔</span></p><span class="sr-only" aria-live="polite" data-project-status></span>
</section>
