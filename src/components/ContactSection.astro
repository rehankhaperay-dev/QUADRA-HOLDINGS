---
import { iconSrcSet, withBase } from '../lib/paths';
---
<!-- Like the upstream contact widget, this is a rounded two-column panel.
     Email is a real mailto link rather than a non-functional form. -->
<section class="widget-panel contact-widget reveal" id="contact" aria-labelledby="contact-heading">
  <div class="widget-heading"><div><span class="widget-kicker">06 / LET'S CONNECT</span><h2 id="contact-heading">Get in touch</h2></div><img class="heading-art" src={withBase("images/ai/mail.webp")} srcset={iconSrcSet("mail")} sizes="58px" width="192" height="192" loading="lazy" decoding="async" alt="" aria-hidden="true" /></div>
  <div class="contact-grid"><div class="contact-main"><h3>Have a project in mind?</h3><p>Whether you're starting fresh or rethinking your website, I'd love to hear what you have in mind.</p><a class="button button-primary magnetic" href="mailto:rehan.khaperay@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a><p class="contact-note">This opens your email application.</p></div><div class="contact-aside"><div class="contact-info"><h3>Contact information</h3><div><span class="info-icon" aria-hidden="true"><img src={withBase("images/ai/mail.webp")} srcset={iconSrcSet("mail")} sizes="58px" width="192" height="192" loading="lazy" decoding="async" alt="" /></span><a href="mailto:rehan.khaperay@gmail.com">rehan.khaperay@gmail.com <span aria-hidden="true">↗</span></a></div><div><span class="info-icon" aria-hidden="true"><img src={withBase("images/ai/location.webp")} srcset={iconSrcSet("location")} sizes="42px" width="192" height="192" loading="lazy" decoding="async" alt="" /></span><span>Saudi Arabia</span></div></div><div class="contact-availability"><h3>Availability</h3><p>Online projects worldwide</p><span><i></i> Available to discuss your project</span></div></div></div>
</section>
