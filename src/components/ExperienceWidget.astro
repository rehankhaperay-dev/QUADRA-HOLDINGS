---
import { iconSrcSet, withBase } from '../lib/paths';
const steps = [
  { icon: 'globe', number: '01', name: 'Discover', title: 'Understand the goal', text: 'Learn about the business, audience, services, and what the website should help visitors do.', note: 'Your goals and the people you want to reach set the direction.' },
  { icon: 'diamond', number: '02', name: 'Plan', title: 'Plan the page', text: 'Organize the content into a clear structure before building the design.', note: 'The structure takes shape around what your website needs to communicate.' },
  { icon: 'storefront', number: '03', name: 'Build', title: 'Build and review', text: 'Create the agreed page layout and review it with the client for feedback.', note: 'The visual design and practical details come together across screen sizes.' },
  { icon: 'spark', number: '04', name: 'Launch', title: 'Prepare to publish', text: 'Confirm mobile layout, links, contact details, and any hosting or domain costs before launch.', note: 'A considered final review helps get everything ready for the next step.' },
];
---
<!-- The template's experience timeline becomes a truthful project process. -->
<section class="widget-panel process-widget reveal" id="process" aria-labelledby="process-heading">
  <div class="widget-heading"><div><span class="widget-kicker">03 / HOW IT COMES TOGETHER</span><h2 id="process-heading">How I work</h2></div><span class="widget-heading-note">A SIMPLE FOUR-STEP PROCESS</span></div>
  <p class="widget-lead process-lead">I aim to keep projects clear and collaborative: agree on the scope, communicate openly, and confirm costs before any paid tools or services are used.</p>
  <div class="process-layout">
    <div class="process-steps" aria-label="Choose a process step">
      {steps.map((step, i) => <a href={`#process-step-${step.number}`} class:list={['process-step', { 'is-active': i === 0 }]} data-process-select={i} aria-current={i === 0 ? 'step' : undefined}><img class="process-icon" src={withBase(`images/ai/${step.icon}.webp`)} srcset={iconSrcSet(step.icon)} sizes="42px" width="192" height="192" loading="lazy" decoding="async" alt="" /><span class="process-step-copy"><strong>{step.title}</strong><small>{step.name}</small></span><span class="step-badge">{step.number} / 04</span></a>)}
    </div>
    <div class="process-panels" data-process-panels>
      {steps.map((step, i) => <div id={`process-step-${step.number}`} class:list={['process-panel', { 'is-active': i === 0 }]} data-process-panel={i}><span class="detail-label">STEP {step.number} / {step.name.toUpperCase()}</span><h3>{step.title}</h3><p>{step.text}</p><div class="process-note"><img src={withBase(`images/ai/${step.icon}.webp`)} srcset={iconSrcSet(step.icon)} sizes="42px" width="192" height="192" loading="lazy" decoding="async" alt="" aria-hidden="true" />{step.note}</div></div>)}
      <span class="sr-only" aria-live="polite" data-process-status></span>
    </div>
  </div>
</section>
