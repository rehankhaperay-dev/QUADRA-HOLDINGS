---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { iconSrcSet, withBase } from '../lib/paths';
const title = 'Quadra Holdings | Thoughtful websites for small businesses';
const description = 'Affordable, thoughtful business websites, landing pages and redesigns for small businesses. Based in Saudi Arabia and available online worldwide.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialPath = withBase('images/quadra-og.jpg');
const socialImage = Astro.site ? new URL(socialPath, Astro.site).href : socialPath;
const backgroundStyles = `--hero-background: url('${withBase('images/ai/hero-background.webp')}'); --dashboard-background: url('${withBase('images/ai/dashboard-background.webp')}')`;
---
<!doctype html>
<html lang="en" style={backgroundStyles}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F8F5" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="64x64" href={withBase("favicon.png")} />
    <link rel="preload" as="image" href={withBase("images/ai/emblem.webp")} imagesrcset={iconSrcSet("emblem")} imagesizes="(max-width: 600px) 158px, 190px" type="image/webp" />
    <link rel="preload" as="image" href={withBase("images/ai/hero-background.webp")} type="image/webp" fetchpriority="high" />
    <link rel="preload" as="font" href={interLatin} type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quadra Holdings" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Quadra Holdings emblem and the words Web design for small businesses" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Quadra Holdings emblem and the words Web design for small businesses" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
